#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    browser_column_widths: [20, 38, 42],
    text_color: "#ebdbb2",
    draw_borders: true,
    tab_bar: (
        enabled: true,
        active_style: (fg: "#d5c4a1", modifiers: "Bold"),
        inactive_style: (fg: "#d5c4a1", modifiers: ""),
    ),
    highlighted_item_style: (fg: "#d5c4a1", modifiers: "Bold"),
    current_item_style: (fg: "#7c6f64", bg: "#d5c4a1", modifiers: "Bold"),
    borders_style: (fg: "#d5c4a1", modifiers: "Bold"),
    highlight_border_style: (fg: "#d5c4a1"),
    symbols: (
        song: "",
        dir: "",
        marker: "* ",
        ellipsis: "...",
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#282828"),
        elapsed_style: (fg: "#d5c4a1"),
        thumb_style: (fg: "#d5c4a1"),
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "#d5c4a1"),
        ends_style: (fg: "#d5c4a1"),
        thumb_style: (fg: "#d5c4a1"),
    ),
    lyrics: (
        timestamp: false,
        current_line_style: ( fg: "#fabd2f", modifiers: "Bold"),
        normal_line_style: ( fg: "#504945" )
    ),
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "#928374"),
                highlighted_item_style: (fg: "#282828", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "gray"),)
            ),
            width: "70%"
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#d5c4a1"),
                default: (kind: Text("Unknown Album"), style: (fg: "gray"))
            ),
            width: "30%"
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "3",
                pane: Pane(Tabs)
            ),
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "100%",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                    (
                                        size: "4",
                                        borders: "ALL",
                                        pane: Pane(Header)
                                    )
                                ]
                            )
                        )
                    ]
                )
            ),
            (
                size: "100%",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "100%",
                            borders: "NONE",
                            pane: Pane(TabContent)
                        )
                    ]
                )
            ),
            (
                size: "3",
                borders: "TOP | BOTTOM",
                pane: Pane(ProgressBar)
            )
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(playing_label: "", paused_label: "", stopped_label: ""))), style: (fg: "#7c6f64", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#edbdd2", modifiers: "Bold"),
                        default: (kind: Property(Song(Filename)), style: (fg: "#edbdd2", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#7c6f64", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#7c6f64", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#7c6f64", modifiers: "Bold")),
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#edbdd2")),
                    (kind: Text("/"), style: (fg: "#7c6f64")),
                    (kind: Property(Status(Duration)), style: (fg: "#edbdd2"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#7c6f64", modifiers: "Bold"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#7c6f64", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Song(Album)), style: (fg: "#7c6f64"))
                ]
            )
        ]
    ),
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],

        bar_width: 1, // width of a single bar in columns
        bar_spacing: 1, // free space between bars in columns

        orientation: Bottom,

        bar_color: Single("#ebdbb2"),
        //bar_color: Gradient({
        //  0: "#b8bb26",
        // 25: "#fabd2f",
        // 50: "#fb4934",
        //})
    ),
)
